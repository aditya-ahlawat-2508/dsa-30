# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real secrets.

# Required to send anything at all. Get one at https://resend.com (free tier).
RESEND_API_KEY=

# Optional. Defaults to Resend's onboarding sender, which only works for
# testing. Verify your own domain in Resend and put a real "from" here once
# you're ready to send for real.
RESEND_FROM_EMAIL=

# Strongly recommended once deployed publicly (this app has no auth of its
# own): locks /api/reminder to only ever send to this address, no matter what
# a caller requests. Should match the email you set in Settings.
REMINDER_ALLOWED_EMAIL=

# Optional. If set, Vercel Cron's daily GET request to /api/reminder must
# carry a matching `Authorization: Bearer <value>` header, which Vercel adds
# automatically when this env var exists in the project — see README.
CRON_SECRET=
